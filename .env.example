# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is already listed in .gitignore).

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model options from the activity: gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.8-flash
# Use whichever one your free-tier key supports.
GEMINI_MODEL=gemini-2.5-flash

# Backup models (comma-separated). Boben tries them in order if the main model is
# busy (503), not found (404) or rate-limited (429). Unknown names are simply skipped.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Accounts and sign-in ------------------------------------------------------------
# Public address of the site (no trailing slash). Leave empty on your own computer.
# In production set it, for example: SITE_URL=https://boben.example.com
SITE_URL=
# Set True when the site runs behind a proxy/host that terminates HTTPS (Render, Railway, Nginx...).
DJANGO_BEHIND_PROXY=False
# Production only: comma-separated origins, for example https://boben.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional: where the SQLite file lives (default: db.sqlite3 next to manage.py)
# DATABASE_PATH=

# OAuth. Client IDs are public, client SECRETS must stay in this file (or real environment variables).
# Never put a secret in code, in the browser, or in Git. Callback URLs to register are listed in README.md.
# REQUIRED to make each button work: GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_SECRET, and for Facebook BOTH
# FACEBOOK_APP_ID and FACEBOOK_APP_SECRET (developers.facebook.com -> your app -> Settings -> Basic).
GOOGLE_CLIENT_ID=1061823963628-ka7d5qf50kpjce9h16iagfa2lcdk8od0.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=Ov23li8iymLHAGbprCYS
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0

